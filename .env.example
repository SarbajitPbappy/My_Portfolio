# Copy to .env.local (git-ignored) and fill in real values.

# --- Public site URL (SEO) ---------------------------------------------------
# REQUIRED in production. Drives canonical URLs, Open Graph/Twitter image URLs,
# sitemap.xml and robots.txt. Set this to your real domain (no trailing slash).
# Also set it in your Vercel project's Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Admin auth --------------------------------------------------------------
# Password for the /admin panel login.
ADMIN_PASSWORD=change-me
# Secret used to sign the admin session token. Falls back to ADMIN_PASSWORD if unset.
AUTH_SECRET=some-long-random-string

# --- Analytics ---------------------------------------------------------------
# Optional. Visits from localhost are NOT counted by default so development
# traffic never inflates the real numbers. Set to "true" to count them while
# testing the /admin -> Analytics dashboard locally.
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# --- Contact form email (Resend) ---------------------------------------------
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=onboarding@resend.dev
TO_EMAIL=you@example.com
